[Unit]
Description=Automatically route audio to a connected Bluetooth headset
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-output-autoswitch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
