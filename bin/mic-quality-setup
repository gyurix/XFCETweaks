#!/usr/bin/env bash
set -euo pipefail

card=1
raw_source="alsa_input.pci-0000_00_1f.3.analog-stereo"
filtered_source="voice_clear"

ensure_filter_input_link() {
    local wanted_output="$1"
    local input_port="$2"

    # PipeWire can auto-route EasyEffects or another virtual source into the
    # filter input after login/resume. Handy then records silence from
    # voice_clear. Keep this filter fed by the real microphone only.
    pw-link -l 2>/dev/null |
        awk -v input_port="$input_port" '
            $0 == input_port { in_input = 1; next }
            /^[^[:space:]]/ { in_input = 0 }
            in_input && $1 == "|<-" { print $2 }
        ' |
        while IFS= read -r existing_output; do
            if [[ -n "$existing_output" && "$existing_output" != "$wanted_output" ]]; then
                pw-link -d "$existing_output" "$input_port" 2>/dev/null || true
            fi
        done

    pw-link "$wanted_output" "$input_port" 2>/dev/null || true
}

apply_settings() {
    if command -v amixer >/dev/null 2>&1; then
        amixer -q -c "$card" set "Mic Boost" 0 || true
        amixer -q -c "$card" set "Internal Mic Boost" 0 || true
        amixer -q -c "$card" set "Capture" 50 || true
    fi

    if pactl list sources short | awk '{print $2}' | grep -Fxq "$filtered_source"; then
        pactl set-default-source "$filtered_source" || true
    else
        pactl set-default-source "$raw_source" || true
    fi
    pactl set-source-mute "$raw_source" 0 || true

    ensure_filter_input_link "$raw_source:capture_FL" "$filtered_source.input:input_FL"
    ensure_filter_input_link "$raw_source:capture_FR" "$filtered_source.input:input_FR"

    pactl list source-outputs short |
        awk -v filtered="$filtered_source" '$2 != filtered { print $1 }' |
        while read -r output; do
            pactl move-source-output "$output" "$filtered_source" 2>/dev/null || true
        done
}

for _ in {1..20}; do
    pactl info >/dev/null 2>&1 && break
    sleep 0.5
done

for _ in {1..20}; do
    pactl list sources short | awk '{print $2}' | grep -Fxq "$filtered_source" && break
    sleep 0.5
done

for _ in {1..20}; do
    pactl list sources short | awk '{print $2}' | grep -Fxq "$raw_source" && break
    sleep 0.5
done

if [[ "${1:-}" == "--watch" ]]; then
    while true; do
        apply_settings
        sleep 2
    done
fi

apply_settings
