#!/usr/bin/env bash
# gpu - full control over the NVIDIA dGPU allocation.
#
#   gpu off               host dGPU may runtime-suspend when clients go idle
#   gpu host              reserve powered-on dGPU for host apps
#   gpu vm                exclusive PCI passthrough to stopped tiny10 VM
#   gpu on                host owns dGPU; VMs use virtual graphics (not PCI GPU)
#   gpu auto              alias for gpu off
#   gpu status             mode, PCI power state, draw, dGPU clients
#   gpu run [--dgpu|--igpu] -- <cmd>...   launch pinned to a GPU
#
# Live contexts cannot move between host and VM. `gpu vm` refuses to detach
# while Xorg or applications use the card. Tiny10 has no stable VirGL 3D
# driver: its virtual display in `gpu on` is 2D, not shared NVIDIA access.
set -euo pipefail

CONF_DIR="$HOME/.config/XFCETweaks"
MODE_FILE="$CONF_DIR/gpu.mode"
ENV_FILE="$CONF_DIR/gpu.env"
HELPER="/usr/local/bin/gpu-power"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-2}"
}

mode() { [[ -f "$MODE_FILE" ]] && cat "$MODE_FILE" || echo "auto"; }

write_env() { # $1 = on|off|auto
    mkdir -p "$CONF_DIR"
    case "$1" in
        off)
            cat > "$ENV_FILE" <<'EOF'
# Generated by `gpu off` - force new launches onto the iGPU.
export CUDA_VISIBLE_DEVICES=-1
export __NV_PRIME_RENDER_OFFLOAD=0
export DRI_PRIME=0
EOF
            ;;
        on)
            cat > "$ENV_FILE" <<'EOF'
# Generated by `gpu on` - allow dGPU offload launches.
export CUDA_VISIBLE_DEVICES=0
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export DRI_PRIME=1
EOF
            ;;
        vm)
            cat > "$ENV_FILE" <<'EOF'
# Generated by `gpu vm` - NVIDIA device belongs exclusively to tiny10.
export CUDA_VISIBLE_DEVICES=-1
export __NV_PRIME_RENDER_OFFLOAD=0
export DRI_PRIME=0
EOF
            ;;
        *)
            cat > "$ENV_FILE" <<'EOF'
# Generated by `gpu auto` - driver decides (dynamic power management).
export CUDA_VISIBLE_DEVICES=0
export __NV_PRIME_RENDER_OFFLOAD=1
export DRI_PRIME=1
EOF
            ;;
    esac
}

sudo_helper() {
    sudo -n "$HELPER" "$@"
}

gpu_clients() {
    # Prints "PID NAME MEM" lines for dGPU clients, Xorg included (caller filters).
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true
    fi
    # Graphics (non-compute) clients hold /dev/nvidia0 too.
    if command -v fuser >/dev/null 2>&1; then
        for node in /dev/nvidia0 /dev/nvidiactl; do
            [[ -e "$node" ]] || continue
            for pid in $(fuser "$node" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true); do
                name="$(ps -o comm= -p "$pid" 2>/dev/null || echo '?')"
                echo "$pid, $name, n/a"
            done
        done | sort -u
    fi
}

cmd_status() {
    echo "mode: $(mode)"
    if [[ -x "$HELPER" ]]; then
        sudo -n "$HELPER" power-state || true
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-gpu=power.draw,temperature.gpu,utilization.gpu,memory.used \
            --format=csv 2>/dev/null || echo "(nvidia-smi unavailable - device may be powered off)"
    else
        echo "(nvidia-smi not installed)"
    fi
    echo "--- dGPU clients ---"
    if [[ -z "$(gpu_clients | sort -u)" ]]; then
        echo "(none reported)"
    else
        gpu_clients | sort -u
    fi
}

cmd_on() {
    [[ $# == 0 ]] || usage
    sudo_helper on
    mkdir -p "$CONF_DIR"
    echo "on" > "$MODE_FILE"
    write_env on
    echo "gpu on: host owns dGPU; tiny10 keeps its 2D virtual display."
}

cmd_off() {
    [[ $# == 0 ]] || usage
    sudo_helper off
    mkdir -p "$CONF_DIR"
    echo "off" > "$MODE_FILE"
    write_env off
    echo "gpu off: host dGPU can suspend when idle; existing clients remain."
}

cmd_auto() {
    [[ $# == 0 ]] || usage
    sudo_helper off
    mkdir -p "$CONF_DIR"
    echo "auto" > "$MODE_FILE"
    write_env off
    echo "gpu auto: host dGPU can suspend when idle."
}

cmd_host() {
    [[ $# == 0 ]] || usage
    sudo_helper host
    mkdir -p "$CONF_DIR"
    echo "host" > "$MODE_FILE"
    write_env on
    echo "gpu host: dGPU reserved for host apps."
}

cmd_vm() {
    [[ $# == 0 ]] || usage
    sudo_helper vm
    mkdir -p "$CONF_DIR"
    echo "vm" > "$MODE_FILE"
    write_env vm
    echo "gpu vm: dGPU reserved for tiny10. Start with: sudo virsh -c qemu:///system start tiny10"
}

cmd_run() {
    local target="" args=()
    while (( $# )); do
        case "$1" in
            --dgpu) target="dgpu"; shift ;;
            --igpu) target="igpu"; shift ;;
            --) shift; args=("$@"); break ;;
            *) args=("$@"); break ;;
        esac
    done
    (( ${#args[@]} )) || usage
    if [[ -z "$target" ]]; then
        case "$(mode)" in
            off|vm) target="igpu" ;;
            *) target="dgpu" ;;
        esac
    fi
    if [[ "$target" == "igpu" ]]; then
        echo "gpu run: launching on iGPU: ${args[*]}" >&2
        env CUDA_VISIBLE_DEVICES=-1 __NV_PRIME_RENDER_OFFLOAD=0 DRI_PRIME=0 "${args[@]}"
    else
        echo "gpu run: launching on dGPU: ${args[*]}" >&2
        env CUDA_VISIBLE_DEVICES=0 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia DRI_PRIME=1 "${args[@]}"
    fi
}

case "${1:-status}" in
    on) shift; cmd_on "$@" ;;
    off) shift; cmd_off "$@" ;;
    host) shift; cmd_host "$@" ;;
    vm) shift; cmd_vm "$@" ;;
    auto) shift; cmd_auto "$@" ;;
    status) cmd_status ;;
    run) shift; cmd_run "$@" ;;
    -h|--help|help) usage 0 ;;
    *) usage ;;
esac
