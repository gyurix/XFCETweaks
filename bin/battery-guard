#!/usr/bin/env bash

set -u

readonly STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly STATE_FILE="${STATE_DIR}/battery-guard.state"
readonly COUNTDOWN_SERVICE="battery-hibernate-countdown.service"

battery=""
for candidate in /sys/class/power_supply/*; do
    [[ -r "$candidate/type" ]] || continue
    [[ "$(<"$candidate/type")" == "Battery" ]] || continue
    [[ -r "$candidate/capacity" && -r "$candidate/status" ]] || continue
    battery="$candidate"
    break
done

[[ -n "$battery" ]] || exit 0

capacity="$(<"$battery/capacity")"
status="$(<"$battery/status")"
[[ "$capacity" =~ ^[0-9]+$ ]] || exit 0

save_state() {
    # TAB-separated: status can be multi-word ("Not charging").
    printf '%s\t%s\t%s\n' "$capacity" "$status" "$now" > "$STATE_FILE"
}

# Native bar (int:value) + glyph+percent badge icon: bar, icon and exact
# percentage together. Names mirror osd-badge chg so the hot path stays
# a single file check.
charge_notify() {
    local summary="$1" pct="$2" rounded level tag
    rounded=$(( (pct / 5) * 5 ))
    level=$(( (pct / 10) * 10 ))
    if [[ "$status" != "Discharging" && "$level" -ge 100 ]]; then
        tag="full"
    elif [[ "$status" != "Discharging" ]]; then
        tag="c$level"
    else
        tag="d$level"
    fi
    [[ -f "$HOME/.local/share/icons/hicolor/48x48/status/osd-chg-$tag-$rounded.png" ]] \
        || $HOME/.local/bin/osd-badge chg "$pct" "$status" > /dev/null
    (( pct > 100 )) && pct=100
    /usr/bin/notify-send \
        --app-name="Charger" \
        --urgency=low \
        --hint="int:value:$pct" \
        --icon="osd-chg-$tag-$rounded" \
        "$summary ${2}%" >/dev/null 2>&1 || true
}

# Charger plug/unplug notification with percentage only (no time estimates).
# Skipped on first run so login doesn't spam.
now="$(date +%s)"
if [[ -r "$STATE_FILE" ]]; then
    IFS=$'\t' read -r _ last_status _rest < "$STATE_FILE" || true
    if [[ -n "${last_status:-}" && "$status" != "$last_status" ]]; then
        if [[ "$last_status" == "Discharging" ]]; then
            charge_notify "Charger plugged in" "$capacity"
        elif [[ "$status" == "Discharging" ]]; then
            charge_notify "On battery" "$capacity"
        fi
    fi
fi

if [[ "$status" != "Discharging" ]]; then
    save_state
    /usr/bin/systemctl --user stop "$COUNTDOWN_SERVICE" 2>/dev/null || true
    exit 0
fi

if (( capacity <= 18 )); then
    save_state
    if ! /usr/bin/systemctl --user start "$COUNTDOWN_SERVICE"; then
        /usr/bin/notify-send \
            --app-name="Battery guard" \
            --urgency=critical \
            --icon=battery-empty \
            "Battery ${capacity}% — countdown failed" \
            "Plug in charger now."
        exit 1
    fi
    exit 0
fi

save_state
