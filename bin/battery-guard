#!/usr/bin/env bash

set -u

readonly STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly STATE_FILE="${STATE_DIR}/battery-guard.state"
readonly COUNTDOWN_SERVICE="battery-hibernate-countdown.service"
readonly LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly LOG_FILE="${LOG_DIR}/battery-guard.log"

battery=""
for candidate in /sys/class/power_supply/*; do
    [[ -r "$candidate/type" ]] || continue
    [[ "$(<"$candidate/type")" == "Battery" ]] || continue
    [[ -r "$candidate/capacity" && -r "$candidate/status" ]] || continue
    battery="$candidate"
    break
done

[[ -n "$battery" ]] || exit 0

capacity="$(<"$battery/capacity")"
status="$(<"$battery/status")"
[[ "$capacity" =~ ^[0-9]+$ ]] || exit 0

fnlock=""
for candidate in /sys/bus/platform/drivers/ideapad_acpi/VPC*/fn_lock; do
    [[ -r "$candidate" ]] || continue
    fnlock="$(<"$candidate")"
    break
done

save_state() {
    # TAB-separated: status can be multi-word ("Not charging").
    printf '%s\t%s\t%s\t%s\n' "$capacity" "$status" "$fnlock" "$now" > "$STATE_FILE"
}

# Native bar (int:value) + glyph+percent badge icon: bar, icon and exact
# percentage together. Names mirror osd-badge chg so the hot path stays
# a single file check.
charge_notify() {
    local summary="$1" pct="$2" rounded level tag
    rounded=$(( (pct / 5) * 5 ))
    level=$(( (pct / 10) * 10 ))
    if [[ "$status" != "Discharging" && "$level" -ge 100 ]]; then
        tag="full"
    elif [[ "$status" != "Discharging" ]]; then
        tag="c$level"
    else
        tag="d$level"
    fi
    [[ -f "$HOME/.local/share/icons/hicolor/48x48/status/osd-chg-$tag-$rounded.png" ]] \
        || $HOME/.local/bin/osd-badge chg "$pct" "$status" > /dev/null
    (( pct > 100 )) && pct=100
    /usr/bin/notify-send \
        --app-name="Charger" \
        --urgency=low \
        --hint="int:value:$pct" \
        --icon="osd-chg-$tag-$rounded" \
        "$summary ${2}%" >/dev/null 2>&1 || true
}

# Charger plug/unplug notification with percentage only (no time estimates).
# Skipped on first run so login doesn't spam.
now="$(date +%s)"
if [[ -r "$STATE_FILE" ]]; then
    IFS=$'\t' read -r _ last_status last_fnlock last_run < "$STATE_FILE" || true
    # A gap >90s since the previous tick means this is the first run after
    # suspend (ticks are 30s) — the EC may have reset FnLock over suspend,
    # which is not a keypress, so don't notify for it.
    gap=0
    if [[ "${last_run:-}" =~ ^[0-9]+$ ]] && (( now - last_run > 90 )); then
        gap=1
    fi
    if [[ -n "${last_status:-}" && "$status" != "$last_status" ]]; then
        if [[ "$last_status" == "Discharging" ]]; then
            charge_notify "Charger plugged in" "$capacity"
        elif [[ "$status" == "Discharging" ]]; then
            charge_notify "On battery" "$capacity"
        fi
    fi
    # FnLock toggled in firmware (Fn+Esc) is invisible to the OS except
    # through this sysfs value — report it when it changes.
    if [[ -n "$fnlock" && -n "${last_fnlock:-}" && "$fnlock" != "$last_fnlock" ]]; then
        mkdir -p "$LOG_DIR" 2>/dev/null || true
        suppress=""
        (( gap == 1 )) && suppress=" (suppressed: post-suspend)"
        printf '%s fnlock %s->%s%s\n' "$(date -Is)" "$last_fnlock" "$fnlock" \
            "$suppress" >> "$LOG_FILE" 2>/dev/null || true
        if (( gap == 0 )); then
            $HOME/.local/bin/fnlock-toggle show >/dev/null 2>&1 || true
        fi
    fi
fi

if [[ "$status" != "Discharging" ]]; then
    save_state
    /usr/bin/systemctl --user stop "$COUNTDOWN_SERVICE" 2>/dev/null || true
    exit 0
fi

if (( capacity <= 18 )); then
    save_state
    if ! /usr/bin/systemctl --user start "$COUNTDOWN_SERVICE"; then
        /usr/bin/notify-send \
            --app-name="Battery guard" \
            --urgency=critical \
            --icon=battery-empty \
            "Battery ${capacity}% — countdown failed" \
            "Plug in charger now."
        exit 1
    fi
    exit 0
fi

save_state
